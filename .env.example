# Copy this file to .env and fill in your keys
# cp .env.example .env

# Required — API endpoint and key
OPENAI_BASE_URL=https://rgvaiclass.com/v1
OPENAI_API_KEY=sk-...

# Optional — needed for web_search, scholar_search, youtube_search builtin tools
SERPAPI_API_KEY=

# Optional: saved login profiles for authenticated crawling
#
# Example profile name: "sso"
#
# A11Y_LOGIN_SSO_URL=https://example.com/login
# A11Y_LOGIN_SSO_USERNAME=user@example.com
# A11Y_LOGIN_SSO_PASSWORD=...
# A11Y_LOGIN_SSO_USERNAME_SELECTOR=input#username
# A11Y_LOGIN_SSO_PASSWORD_SELECTOR=input#password
# A11Y_LOGIN_SSO_SUBMIT_SELECTOR=button[type=submit]
# A11Y_LOGIN_SSO_POST_LOGIN_URL_PREFIX=https://example.com/app
